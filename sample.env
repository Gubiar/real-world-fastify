PORT=3000
HOST=0.0.0.0
NODE_ENV=development
ENABLE_DOCS=true
RUN_MIGRATIONS_ON_STARTUP=false
TRUST_PROXY=false

DATABASE_URL=postgresql://admin:admin@localhost:5432/mydb
DB_POOL_MAX=10

POSTGRES_USER=app_user
POSTGRES_PASSWORD=strong_password_change_me
POSTGRES_DB=app_db

JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-required
JWT_EXPIRES_IN=1d
JWT_ISSUER=real-world-fastify
JWT_AUDIENCE=real-world-fastify-users

CORS_ORIGIN=http://localhost:3000,http://localhost:3001

BCRYPT_ROUNDS=10

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1 minute"
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW="1 minute"

LOG_LEVEL=info
